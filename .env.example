# Copia este archivo a .env y completa los valores.
# Con docker-compose, POSTGRES_HOST=db y REDIS_URL=redis://redis:6379/0.
# Para desarrollo local sin Docker usa POSTGRES_HOST=localhost y REDIS_URL=redis://localhost:6379/0.

DJANGO_SECRET_KEY=change-me-a-long-random-secret
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=*

POSTGRES_DB=rag
POSTGRES_USER=rag
POSTGRES_PASSWORD=rag
POSTGRES_HOST=db
POSTGRES_PORT=5432

REDIS_URL=redis://redis:6379/0

# Proveedores de chat y embeddings (fallback si el agente no trae su propia key)
OPENAI_API_KEY=sk-...
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_LLM_MODEL=gpt-4o-mini
OPENAI_RERANK_MODEL=gpt-4o-mini
EMBEDDING_DIM=1536

# Claves opcionales por proveedor (el agente puede llevar su propia key en el panel)
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
MISTRAL_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
CUSTOM_API_KEY=

# Pipeline de búsqueda
HYBRID_TOP_K=20
RERANK_TOP_K=5
RERANK_STRATEGY=llm

# Chunking
CHUNK_SIZE=800
CHUNK_OVERLAP=80
USE_SEMANTIC_GUARD=0

# Lotes y límites
EMBED_BATCH_SIZE=16
LLM_TIMEOUT=60
MAX_CONTEXT_TOKENS=32000
WHOOSH_INDEX_DIR=/app/storage/whoosh
